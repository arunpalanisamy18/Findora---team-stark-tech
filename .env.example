NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
MONGODB_URI=mongodb://127.0.0.1:27017/findora
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
# Only enable for local development; OTPs are logged to backend console, never returned by API.
AUTH_DEV_SHOW_OTP=false
# Optional mail integration. Delivery adapter must be configured; no email is faked.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
# Set true only behind exactly one trusted reverse proxy.
TRUST_PROXY=false
# Seed initial admin only using the documented seed command; never commit credentials.
ADMIN_NAME=Findora Administrator
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=
